                "conditions": [
                  {"leftValue": "={{ $json.body.event }}", "rightValue": "approval.approved", "operator": {"type": "string", "operation": "equals"}}
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Aprovado"
            }
