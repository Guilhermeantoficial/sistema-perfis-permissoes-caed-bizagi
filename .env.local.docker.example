APP_NAME=Gestão de Perfis e Permissões
APP_VERSION=2.0.0
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=local-docker-secret-change-this-32-characters
AUTH_MODE=local
BOOTSTRAP_ADMIN_NAME=Guilherme Rodrigues
BOOTSTRAP_ADMIN_EMAIL=guilhermeantoniooficial@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=TroqueEstaSenha!123
DATABASE_URL=postgresql+psycopg://caed_app:local-postgres-password@db:5432/caed_permissions
POSTGRES_DB=caed_permissions
POSTGRES_USER=caed_app
POSTGRES_PASSWORD=local-postgres-password
RUN_MIGRATIONS_ON_STARTUP=false
SEED_ON_STARTUP=false
SESSION_HTTPS_ONLY=false
FORCE_HTTPS=false
TRUSTED_HOSTS=localhost,127.0.0.1,web,testserver
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FORWARDED_ALLOW_IPS=127.0.0.1
ENABLE_API_DOCS=true
LOG_JSON=false
BIZAGI_ENABLED=false
N8N_ENABLED=false
SMTP_ENABLED=false
