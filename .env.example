# Copie para .env para execução local direta (sem Docker).
APP_NAME=Gestão de Perfis e Permissões
APP_VERSION=2.0.0
APP_ENV=local
PUBLIC_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=local-only-change-me-with-at-least-32-characters
AUTH_MODE=local
ALLOW_LOCAL_AUTH_NONLOCAL=false
BOOTSTRAP_ADMIN_NAME=Guilherme Rodrigues
BOOTSTRAP_ADMIN_EMAIL=guilhermeantoniooficial@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=TroqueEstaSenha!123
DATABASE_URL=sqlite:///data/app.db
RUN_MIGRATIONS_ON_STARTUP=true
SEED_ON_STARTUP=true
SESSION_HTTPS_ONLY=false
FORCE_HTTPS=false
TRUSTED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ENABLE_API_DOCS=true
LOG_LEVEL=INFO
LOG_JSON=false
BIZAGI_ENABLED=false
N8N_ENABLED=false
SMTP_ENABLED=false
